{
  "name": "second-algorithm-api",
  "main": "server/cloud-worker.mjs",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "vars": {
    "API_CLOUD_ENABLED": "false",
    "API_CLOUD_MODEL": "gpt-6.1-sol",
    "API_CLOUD_REASONING": "xhigh"
  },
  "services": [{ "binding": "SERIES_USAGE", "service": "the-second-language-api", "entrypoint": "AlgorithmUsage" }],
  "secrets_store_secrets": [{
    "binding": "SECOND_SERIES_OPENAI_KEY",
    "store_id": "390f0d98fd864ed7be7b3360d7a50816",
    "secret_name": "SECOND_SERIES_OPENAI_KEY"
  }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "second-algorithm",
    "database_id": "c396b1ca-43fb-4a77-b9b2-c90c7f436b41",
    "migrations_dir": "migrations"
  }]
}
