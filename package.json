{
  "name": "the-second-algorithm",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@simplewebauthn/server": "13.3.0"
  },
  "devDependencies": {
    "marked": "17.0.5",
    "esbuild": "0.25.12",
    "wrangler": "4.140.0",
    "highlight.js": "11.11.1",
    "playwright": "1.62.1"
  },
  "scripts": {
    "build": "node scripts/build-carrier.mjs",
    "test:carrier": "node --test test/carrier-*.test.mjs",
    "dev": "wrangler pages dev dist --port 8796",
