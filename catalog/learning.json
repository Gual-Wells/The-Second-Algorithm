    {
      "id": "equal-positions",
      "title": "在有序数组中找目标值的完整等值范围",
      "document": "practice-foundations",
      "contract": "输入非降vector<int>及int目标；不修改输入；返回0-based半开下标[first,last)，无匹配两端相等，允许空数组与重复。",
      "sourceUrls": [
        "https://cp-algorithms.com/num_methods/binary_search.html"
      ],
      "methods": [
        {
          "id": "boundary-search",
          "title": "查首个不小于与首个大于的位置",
          "invariant": "排除区间分别位于目标边界两侧，每轮严格缩短候选范围。",
          "implementations": [
            {
              "id": "equal-positions-manual",
              "kind": "manual",
              "symbol": "equal_positions_manual",
              "source": "content/practice-foundations/实战起点.cpp",
